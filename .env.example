# Naming: APP_* settings of the app itself; DATABASE_*, PORT as usual; a provider's settings under its name
# (ANTHROPIC_*, TTS_*, PADDLE_*, SMTP_*, RESEND_*, GOOGLE_*, POSTHOG_*); AI_* is AI policy that doesn't depend on a provider.
# Renamed in 0.8.0, old names still work for now: COOKIE_SECURE -> APP_COOKIE_SECURE, SUPPORT_EMAIL -> APP_SUPPORT_EMAIL.
# Copy to .env for local development (read by the "local" Spring profile). Never commit .env.
# Everything is optional locally: without AI keys the game uses its built-in fallback content and plays without voice.

# --- Database (docker compose up -d starts a matching PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/insidejoke
DATABASE_USER=insidejoke
DATABASE_PASSWORD=insidejoke

# --- Public address and access ---
# The QR code and join links point here. To join from phones on your Wi-Fi, use your computer's LAN address,
# e.g. http://192.168.1.20:5173, run the dev server with "npm run dev -- --host", and add it to APP_ALLOWED_ORIGINS.
APP_PUBLIC_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Emails that get the ADMIN role (/admin) when they sign in, comma separated.
APP_ADMIN_EMAILS=admin@example.com
APP_COOKIE_SECURE=false
PORT=8080

# --- Sign-in ---
# "log" prints the 6-digit code to the backend log; "resend" sends it through Resend.
# Sign-in emails: log (written to the log, local only), smtp (Gmail, Yandex, your server) or resend. See docs/MAIL.md.
MAIL_PROVIDER=log
MAIL_FROM=Inside Joke <login@insidejoke.app>
RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com
# MAIL_PROVIDER=smtp. Gmail: smtp.gmail.com, 587, starttls, your full address and an app password (docs/MAIL.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10s
# Google sign-in is hidden unless both are set. Register this redirect URI in the Google client:
#   {APP_PUBLIC_URL}/login/oauth2/code/google
# Locally that's http://localhost:5173/login/oauth2/code/google (through the Vite dev server); add
# http://localhost:8080/login/oauth2/code/google too if you also open the backend jar directly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI host ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5
# Prices in millionths of a dollar, used for the AI cost records and the daily free-game budget.
ANTHROPIC_INPUT_MICROS_PER_TOKEN=1
ANTHROPIC_OUTPUT_MICROS_PER_TOKEN=5
# Any provider with an OpenAI-compatible POST /v1/audio/speech endpoint. Empty key = text only.
TTS_BASE_URL=https://api.openai.com
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=onyx
TTS_MICROS_PER_CHAR=15
# Secrets feed the AI host's jokes, so they need the model's check. true (production): without a model, secrets are
# turned off and the phones don't offer them; if the model is briefly unreachable, a secret is refused with "try again".
# false (local, the default of the "local" profile): without a key, secrets are checked by the rules only.
# Intake answers are always accepted on the rules when there is no model.
AI_REQUIRE_LLM_MODERATION=false

# --- Payments (Paddle Billing) ---
# Without a client token and both price ids the pass buttons are disabled; existing passes keep working.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PARTY_PASS=
PADDLE_PRICE_HOST_PASS=
APP_SUPPORT_EMAIL=support@insidejoke.app

# --- Product analytics (PostHog). Empty key = no analytics. ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Per-room limits (optional; defaults shown) ---
# APP_GAME_ROOM_LLM_BUDGET=40                  AI calls for content per room
# APP_GAME_ROOM_TTS_BUDGET=60                  voice lines per room
# APP_GAME_ROOM_MODERATION_BUDGET=200          moderation checks per room and game
# APP_GAME_MAX_MODERATION_CHECKS_PER_PLAYER=25 moderation checks per player
